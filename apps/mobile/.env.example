# انسخ هذا الملف إلى `.env` وعدّل حسب الحاجة (لا ترفع `.env` إلى Git).
# أولوية القراءة: --dart-define=API_BASE_URL=... ثم `.env` ثم الإنتاج الافتراضي.

# محلي — Android Emulator (API على جهازك)
API_BASE_URL=http://10.0.2.2:4000/api/v1

# إنتاج — علّق السطر أعلاه وفعّل التالي:
# API_BASE_URL=https://studyzhouse.com/api/v1

# جهاز Android físico على نفس شبكة Wi‑Fi (استبدل IP جهازك):
# API_BASE_URL=http://192.168.1.100:4000/api/v1
