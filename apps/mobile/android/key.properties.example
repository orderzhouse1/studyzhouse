# Copy this file to `key.properties` (same folder) and fill in real values.
# NEVER commit the real `key.properties` or the .jks keystore — both are git-ignored.
#
#   cp key.properties.example key.properties
#
# storeFile is resolved relative to apps/mobile/android/ (where this file lives),
# unless you give an absolute path (e.g. C:/secure/keystores/upload-keystore.jks).

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
